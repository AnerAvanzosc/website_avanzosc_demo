<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         Task 1.2 — Header desktop layout
         Scope: herencia sobre website.template_header_default para:
           1. Reemplazar botón "Contact Us" por "Acceso clientes".
           2. Eliminar Sign in / User dropdown del navbar_nav.
           3. Activar el selector de idioma (text variant, sin flag).
         Ref: CLAUDE.md §3, §4, §10; spec §8.1; task 1.2.
         ============================================================ -->

    <!-- 1. Botón «Acceso clientes» — override del CTA del header default.
         REGRESIÓN F3 corregida (T1.1, 2026-06-11): la vía v14 (override de
         las QWeb vars cta_btn_href/cta_btn_text en website.layout) quedó
         INERTE en v18 — las t-set siguen existiendo en website.layout
         (website_templates.xml:182-183 v18) y la herencia aplicaba sin
         error, pero ya NADA las consume: el CTA real es un <a> hardcodeado
         href="/contactus" dentro de website.header_call_to_action
         (website_templates.xml:2261-2272 v18), que template_header_default
         invoca vía placeholder. Se hereda ese template y se reemplaza el
         <a> conservando sus clases (btn_cta lleva los estilos y el glow).
         Solo afecta a desktop: nuestro header mobile reemplaza íntegro el
         buttons-wrap core con su propio «Acceso clientes» (ver abajo).
         href: /clientes (alias público redirige 301 a /web/login per Q2). -->
    <template id="header_acceso_clientes"
              name="Header: Acceso clientes button"
              inherit_id="website.header_call_to_action">
        <xpath expr="//a[hasclass('btn_cta')]" position="replace">
            <a href="/clientes" class="oe_unremovable btn btn-primary btn_cta">Acceso clientes</a>
        </xpath>
    </template>

    <!-- 2. Eliminar Sign in y User dropdown del navbar_nav.
         Hereda website.template_header_default (que pone esas dos llamadas
         dentro del bloque <t t-call="website.navbar_nav">).
         Con «Acceso clientes» ya en la zona oe_structure_header_default_1
         como botón destacado, no queremos duplicar el acceso al portal dentro
         del nav. Se eliminan ambas llamadas.
         Ref: CLAUDE.md §10 (no duplicar accesos), task 1.2 punto 3. -->
    <template id="header_remove_portal_nav_items"
              name="Header: remove Sign in and User dropdown from nav"
              inherit_id="website.template_header_default">
        <!-- Eliminar placeholder Sign in del navbar. portal.placeholder_user_sign_in
             muestra el enlace «Sign in» solo cuando el visitante no está
             autenticado; con el botón «Acceso clientes» cubrimos ese caso. -->
        <xpath expr="//t[@t-call='portal.placeholder_user_sign_in']"
               position="replace"/>
        <!-- Eliminar portal.user_dropdown del navbar: el dropdown de usuario
             autenticado. Los usuarios con portal tienen acceso desde el menú
             de My Account vía /web/login o /my/home. -->
        <xpath expr="//t[@t-call='portal.user_dropdown']"
               position="replace"/>
    </template>

    <!-- 3a. Activar header_language_selector (dropdown text variant).
          El template website.header_language_selector hereda de
          website.placeholder_header_language_selector y, cuando active=True,
          inyecta el widget dropdown de idiomas en el header.
          Estaba active=False en la instalación base. Lo activamos aquí.
          Ref: CLAUDE.md §4 (record con xml_id externo), task 1.2 punto 4. -->
    <record id="website.header_language_selector" model="ir.ui.view">
        <!-- Activar el selector de idioma (dropdown text) en el header. -->
        <field name="active" eval="True"/>
    </record>

    <!-- 3b. Desactivar header_language_selector_flag.
          Este template hijo añade banderas al selector. Con active=False
          el selector mostrará solo texto (ES / Euskara) sin iconos de bandera.
          Ref: task 1.2 punto 4 (text variant, sin flag). -->
    <record id="website.header_language_selector_flag" model="ir.ui.view">
        <!-- Desactivar variante de bandera: queremos texto limpio, no flags. -->
        <!-- noupdate omitido: si se ejecuta `-u website` sin nuestro módulo
             cargado simultáneamente, el flag puede revertir a True. Asumimos
             que el módulo `website_avanzosc_demo` se mantiene cargado en
             producción y se actualiza junto con `website` cuando aplique. -->
        <field name="active" eval="False"/>
    </record>

    <!-- 3c. T1.4 (auditoría UI 2026-06-11) — carrito y buscador fuera del
         header global. Spec §8.1: header = menú + «Acceso clientes»; el
         bootstrap v18 de website_sale inyecta el icono del carrito en el
         header default (website_sale/views/templates.xml:44-52 v18) y
         website activa el search box (placeholder pattern, mismo que el
         language selector). El carrito/checkout siguen operativos dentro
         de /shop — solo desaparece el icono global del header.
         CAVEAT BD existente: si hay copias COW per-website de estos
         templates (sin xml_id, p.ej. website_sale.template_header_default
         website_id=1 en la BD QA), el record declarativo NO las alcanza —
         desactivarlas post-deploy vía ORM/psql (patrón gotcha cache_time,
         CLAUDE.md §5). Aplicado a la BD QA vía shell 2026-06-11. -->
    <record id="website_sale.template_header_default" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>
    <record id="website.header_search_box" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>
    <!-- Text element del header v18: teléfono demo «+1 555-555-5556»
         HARDCODEADO en el template core (website_templates.xml:2998+,
         placeholder pattern) — no lee res.company, así que el fix de
         datos T1.3 no lo corrige. Spec §8.1: header sin teléfono. -->
    <record id="website.header_text_element" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!-- ============================================================
         Task 1.3 — Sticky header con estado «scrolled»
         ============================================================ -->

    <!-- Desactivar la opción de Odoo «Header Visibility Standard».
         Por qué: el template añade la clase `o_header_standard` al header,
         lo que dispara el widget `publicWidget.registry.StandardAffixedHeader`
         (addons/website/static/src/js/content/menu.js:238) que aplica un
         comportamiento incompatible con el spec de Task 1.3 — desliza el
         header off-screen con `transform: translate(0, -100%)` cuando el
         scroll supera la altura del header, y lo hace re-aparecer al pasar
         `scrolledPoint` (300px por defecto). Spec §8.1 + briefing 1.3 piden
         lo opuesto: el header se mantiene SIEMPRE visible (sticky) y solo
         compacta padding + añade sombra al pasar ~100px.
         Sin la clase, ningún widget de header animado matchea el selector,
         y nuestro position:sticky CSS más el handler de scroll de main.js
         operan limpiamente sin pelear con el framework.

         Trade-off menor: perdemos `o_top_fixed_element` toggle (lo añade el
         widget desactivado, lo consume el snippet `s_table_of_content` para
         compensar el offset al hacer scroll a anchors). En v1 no hay TOC, no
         impacta. Si en futuras tareas se necesita TOC, replicar la clase
         desde nuestra propia lógica.

         noupdate omitido por las mismas razones documentadas en
         header_language_selector_flag (active=False persiste mientras nuestro
         módulo se mantenga cargado y se actualice junto con `website`). -->
    <record id="website.header_visibility_standard" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!-- ============================================================
         Task 1.4 — Footer Avanzosc (4 columnas + bottom strip)
         Spec §8.2, CLAUDE.md §3.
         ============================================================ -->

    <!-- Desactivar el footer default «footer_custom» (3-col Useful Links /
         About us / Connect with us). Sustituimos por nuestro propio template
         `footer_avanzosc` que hereda directamente de `website.layout`, igual
         patrón que las otras 8 variantes core (template_footer_descriptive,
         _centered, _links, etc.). Mutuamente excluyente — solo un template
         de la familia footer puede estar activo a la vez. -->
    <record id="website.footer_custom" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!-- Desactivar la variante con bandera del switcher de idiomas en footer.
         Mismo patrón que `header_language_selector_flag` (Task 1.2):
         queremos texto-only en footer también, coherente con el header.
         `portal.footer_language_selector` se mantiene activo (es el wrapper
         canónico que inyecta el selector tras `o_footer_copyright_name`). -->
    <record id="website.footer_language_selector_flag" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <!-- Footer principal — 4 columnas: Avanzosc / Soluciones / Empresa / Legal.
         Hereda website.layout (no footer_custom) y reemplaza el contenido
         del placeholder #footer.

         Strings en castellano (idioma fuente per spec D1 ES + EU). Las
         traducciones EU viven en `i18n/eu.po` y se aplican automáticamente
         cuando el idioma activo del request es `eu_ES`. NO usamos t-if/else
         manual por idioma — usamos el sistema canónico de traducciones de
         Odoo (extracción automática de QWeb, .po files, ir.translation).

         Páginas legales (/aviso-legal, /politica-privacidad,
         /politica-cookies): los enlaces apuntan a URLs que aún NO existen
         como `website.page` — devolverán 404 hasta su tarea posterior.
         Esperado, no es bug. -->
    <template id="footer_avanzosc"
              name="Footer Avanzosc"
              inherit_id="website.layout">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="oe_structure oe_structure_solo s_avanzosc_footer" t-ignore="true" t-if="not no_footer">
                <section class="s_avanzosc_footer_main">
                    <div class="container">
                        <div class="row">
                            <!-- Columna 1: Avanzosc — logo + claim. -->
                            <div class="col-lg-3 col-md-6 mb-4 s_avanzosc_footer_brand">
                                <a href="/" class="d-block mb-3">
                                    <span t-field="res_company.logo"
                                          t-options="{'widget': 'image', 'class': 'img-fluid s_avanzosc_footer_logo', 'alt-field': 'name'}"/>
                                </a>
                                <p class="s_avanzosc_footer_claim">Odoo industrial de verdad, desde 2008.</p>
                            </div>
                            <!-- Columna 2: Soluciones (4 sectoriales).
                                 URLs idénticas a las del dropdown del header
                                 (data/menu.xml + post_init_hook). -->
                            <div class="col-lg-3 col-md-6 mb-4">
                                <h3 class="s_avanzosc_footer_heading">Soluciones</h3>
                                <ul class="list-unstyled">
                                    <li><a href="/industrial">Industrial</a></li>
                                    <li><a href="/distribucion">Distribución</a></li>
                                    <li><a href="/servicios">Servicios</a></li>
                                    <li><a href="/academias">Academias</a></li>
                                </ul>
                            </div>
                            <!-- Columna 3: Empresa. URLs idénticas a los
                                 menus top-level correspondientes. -->
                            <div class="col-lg-3 col-md-6 mb-4">
                                <h3 class="s_avanzosc_footer_heading">Empresa</h3>
                                <ul class="list-unstyled">
                                    <li><a href="/conocenos">Conócenos</a></li>
                                    <li><a href="/contacto">Contacto</a></li>
                                </ul>
                            </div>
                            <!-- Columna 4: Legal. Las 3 páginas son
                                 placeholder (404 hasta tarea posterior). -->
                            <div class="col-lg-3 col-md-6 mb-4">
                                <h3 class="s_avanzosc_footer_heading">Legal</h3>
                                <ul class="list-unstyled">
                                    <li><a href="/aviso-legal">Aviso Legal</a></li>
                                    <li><a href="/politica-privacidad">Política de Privacidad</a></li>
                                    <li><a href="/politica-cookies">Política de Cookies</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </xpath>
    </template>

    <!-- ============================================================
         Phase 7 (Tasks 7.1 + 7.3) — Mobile header buttons (v18 approach C).
         Heredamos website.template_header_mobile (en v14 era
         template_header_default; v18 separó el header mobile en su
         propio sub-template t-call'eado desde template_header_default).

         (1) Sustituimos íntegramente la <ul o_header_mobile_buttons_wrap>
             nativa, que contiene el botón Bootstrap offcanvas
             (navbar-toggler-icon → #top_menu_collapse_mobile), por nuestro
             markup hamburger Lucide + acceso clientes envueltos en
             <li class="nav-item"> (patrón idiomático v18).

         (2) Suprimimos también el <div id="top_menu_collapse_mobile">
             offcanvas wrapper — ya no se activa porque nuestro hamburger
             abre #s_avanzosc_mobile_overlay (template layout_mobile_overlay
             más abajo), no el offcanvas nativo. Dejarlo serían ~30 líneas
             de HTML muerto.

         JS publicWidget en static/src/js/snippets/header.js sigue intacto:
         monta sobre selector '.s_avanzosc_hamburger' y abre el overlay
         custom por id. Sin cambios al JS.

         ARIA: <span class="s_avanzosc_sr_only"> contiene el texto
         accesible — extraíble por i18n de Odoo. aria-label hardcoded
         ES como fallback. EU vía DRAFT en eu.po.

         Ref: spec §8.1, plan §7.1 + §7.3, decisión sesión 2026-04-29
         (B1 acordeón cerrado, fade 200ms, switcher cierra+navega).
         Q2 cerrada sesión 2026-04-30: alias público /clientes → /web/login
         vía redirect 301 en data/redirects.xml.
         ============================================================ -->
    <template id="header_mobile_buttons"
              name="Header: mobile hamburger and user icon (&lt;992px)"
              inherit_id="website.template_header_mobile">
        <xpath expr="//ul[hasclass('o_header_mobile_buttons_wrap')]" position="replace">
            <ul class="o_header_mobile_buttons_wrap navbar-nav flex-row align-items-center gap-2 mb-0">
                <li class="nav-item">
                    <button type="button"
                            class="s_avanzosc_hamburger"
                            aria-label="Abrir menú"
                            aria-expanded="false"
                            aria-controls="s_avanzosc_mobile_overlay">
                        <i data-lucide="menu" aria-hidden="true"/>
                        <span class="s_avanzosc_sr_only">Abrir menú</span>
                    </button>
                </li>
                <li class="nav-item">
                    <a href="/clientes"
                       class="s_avanzosc_acceso_clientes_mobile"
                       aria-label="Acceso clientes">
                        <i data-lucide="user" aria-hidden="true"/>
                        <span class="s_avanzosc_sr_only">Acceso clientes</span>
                    </a>
                </li>
            </ul>
        </xpath>
        <xpath expr="//div[@id='top_menu_collapse_mobile']" position="replace"/>
    </template>

    <!-- ============================================================
         Phase 7 (Task 7.2) — Mobile overlay
         Overlay full-screen activado por hamburger. Vivien fuera del
         <header> sticky, hijo directo de <body> a través de inserción
         en `website.layout` después del header. z-index 1050 (sobre
         header sticky 1020 y modal-backdrop 1040).

         Estructura del overlay:
           - Header del overlay con botón close (X).
           - Nav vertical con 7 items top-level. Item «Soluciones»
             es un `<button>` que toggles el submenu (acordeón cerrado
             por defecto).
           - Switcher idioma flat list (ES / EU) — usa el helper
             `url_for(..., lang_code=...)` para generar URL traducida
             de la página actual + cookie set automáticamente.

         JS (`static/src/js/snippets/header.js`) gestiona open/close,
         body scroll lock, accordion toggle, Escape key, link clicks.

         Ref: spec §8.1, plan §7.2.
         ============================================================ -->
    <template id="layout_mobile_overlay"
              name="Layout: mobile overlay menu"
              inherit_id="website.layout">
        <xpath expr="//header" position="after">
            <div id="s_avanzosc_mobile_overlay"
                 class="s_avanzosc_mobile_overlay"
                 aria-hidden="true"
                 role="dialog"
                 aria-modal="true"
                 aria-label="Menú principal">
                <div class="s_avanzosc_mobile_overlay_inner">

                    <div class="s_avanzosc_mobile_overlay_header">
                        <button type="button"
                                class="s_avanzosc_mobile_overlay_close"
                                aria-label="Cerrar menú">
                            <i data-lucide="x" aria-hidden="true"/>
                            <span class="s_avanzosc_sr_only">Cerrar menú</span>
                        </button>
                    </div>

                    <nav class="s_avanzosc_mobile_overlay_nav"
                         aria-label="Navegación principal">
                        <ul>
                            <li><a href="/">Inicio</a></li>
                            <li class="s_avanzosc_mobile_overlay_dropdown">
                                <button type="button"
                                        class="s_avanzosc_mobile_overlay_dropdown_toggle"
                                        aria-expanded="false"
                                        aria-controls="s_avanzosc_mobile_overlay_submenu_soluciones">
                                    <span>Soluciones</span>
                                    <i data-lucide="chevron-down" aria-hidden="true"/>
                                </button>
                                <ul id="s_avanzosc_mobile_overlay_submenu_soluciones"
                                    class="s_avanzosc_mobile_overlay_submenu">
                                    <li><a href="/industrial">Industrial</a></li>
                                    <li><a href="/distribucion">Distribución</a></li>
                                    <li><a href="/servicios">Servicios</a></li>
                                    <li><a href="/academias">Academias</a></li>
                                </ul>
                            </li>
                            <li><a href="/tienda">Tienda</a></li>
                            <li><a href="/formacion">Formación</a></li>
                            <li><a href="/contacto">Contacto</a></li>
                            <li><a href="/conocenos">Conócenos</a></li>
                        </ul>
                    </nav>

                    <!-- Switcher idioma — flat list. Usamos `url_for` con
                         `lang_code` igual que `portal.language_selector`
                         para que la URL traducida se compute correctamente
                         (incluye query string actual via keep_query).
                         Idioma activo: clase `.is-active` cuando coincide
                         con `request.context['lang']`. -->
                    <div class="s_avanzosc_mobile_overlay_lang"
                         t-if="len(request.website.language_ids) &gt; 1">
                        <t t-foreach="request.website.language_ids" t-as="lg">
                            <a t-att-href="url_for(request.httprequest.path + '?' + keep_query(), lang_code=lg.code)"
                               t-att-data-url_code="lg.url_code"
                               t-att-data-lang="lg.code"
                               t-attf-class="s_avanzosc_mobile_overlay_lang_item js_change_lang #{lg.code == (request.context.get('lang') or request.lang.code) and 'is-active' or ''}">
                                <t t-esc="lg.name.split('/').pop().strip()"/>
                            </a>
                        </t>
                    </div>

                </div>
            </div>
        </xpath>
    </template>

    <!-- ============================================================
         Post-v1 sub-bloque A — Page transition fade overlay
         Overlay full-screen (fixed inset:0) que aparece con fade-out
         de 200ms cuando el usuario hace click en un link interno.
         Decisión sub-bloque A: fade-out only (no fade-in en la página
         destino), color var(neutral-0) blanco.

         Inserción al final de <body> via xpath after //footer (el
         último elemento estructural dentro de #wrapwrap). z-index
         9999 en SCSS la pone sobre header sticky / modal-backdrop.
         pointer-events:none cuando inactiva; auto durante is-leaving
         (bloquea interacción durante el fade-out).

         JS: static/src/js/snippets/page_transition.js
         SCSS: static/src/scss/snippets/_page_transition.scss
         ============================================================ -->
    <template id="layout_page_transition_overlay"
              name="Layout: page transition fade overlay"
              inherit_id="website.layout">
        <xpath expr="//footer" position="after">
            <div class="s_avanzosc_page_transition" aria-hidden="true"/>
        </xpath>
    </template>

    <!-- Copyright text — sustituye el span hardcoded de `website.layout`
         (línea 178-179: «Copyright © Company name») por el identificador
         legal real de Avanzosc S.L. (CIF + razón social). Per spec §13.

         Por qué replace y no edit: `website.layout` ya hace `position="replace"`
         del span original de `web.layout`. Encadenamos otro replace para
         tener el último valor. El selector `//footer//span[hasclass(...)]`
         es idéntico al que usa `website.layout` — match seguro.

         portal.footer_language_selector inserta el switcher mediante
         `position="after"` sobre el mismo selector — se ejecuta después de
         nuestro replace y opera sobre nuestro span (mismo class), sin
         conflicto. Cadena de orden: web.layout (define) → website.layout
         (replace 1) → website_avanzosc_demo (replace 2) → portal (after).

         Texto NO se traduce (CIF e identificador legal idéntico ES/EU). -->
    <template id="footer_copyright_avanzosc"
              name="Footer Copyright Avanzosc"
              inherit_id="website.layout">
        <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
            <span class="o_footer_copyright_name me-2">© 2026 Avanzosc S.L. — CIF B20875340</span>
        </xpath>
    </template>

    <!-- ============================================================
         Sprint B1 — a11y/SEO trivial wins (Sprint A 2026-05-04 audit).
         ============================================================ -->

    <!-- C1 — eliminar role="menuitem"/role="menu" del navbar.
         Origen: core `website.submenu` (`base/addons/website/views/website_templates.xml:9`)
         emite `<a role="menuitem">` para cada item del navbar (top-level
         + dropdown leaves) y `<ul role="menu">` para los dropdown-menu.

         Problema axe-core (`aria-required-parent`, WCAG 4.1.2): los
         `<a role="menuitem">` top-level están dentro de `<ul class="navbar-nav">`
         que NO tiene `role="menubar"`, lo que el rule reporta como
         contenedor inválido (5 nodos × 12 páginas = 60 violations en la
         auditoría 2026-05-04 §C1).

         Decisión Sprint B1 (per brief): eliminar el role en lugar de
         semantizar el padre. Los `<a>` del navbar funcionan correctamente
         como links sin role; añadir `role="menubar"` exigiría además
         keyboard nav tipo arrow-keys que el navbar de Odoo NO implementa
         (sería WCAG 4.1.2 fail por otro lado: rol declarado sin
         interacciones esperadas).

         Override de website.submenu: vaciamos los 2 atributos role.
         `<attribute name="X"></attribute>` con contenido vacío hace que
         Odoo emita `role=""`, que el browser y axe-core ignoran. -->
    <template id="navbar_remove_role_attributes"
              name="Header: remove ARIA role=menuitem/menu from navbar (C1)"
              inherit_id="website.submenu">
        <!-- Remove role="menuitem" del <a> de cada item del menú
             (top-level + dropdown leaves). El <a> es el único elemento
             dentro de website.submenu con role="menuitem". -->
        <!-- IMPORTANTE (v18, M6): los xpath de herencia Odoo aplican SOLO
             al primer match. El arch v18 de website.submenu tiene DOS <a
             role="menuitem"> (leaf :9 y dropdown toggle :18), DOS <li
             role="presentation"> (:6, :15) y un <div role="menuitem">
             (mega menu :26). Se repite cada xpath por ocurrencia: tras
             limpiar la primera, la misma expresión matchea la siguiente. -->
        <xpath expr="//a[@role='menuitem']" position="attributes">
            <attribute name="role"></attribute>
        </xpath>
        <xpath expr="//a[@role='menuitem']" position="attributes">
            <attribute name="role"></attribute>
        </xpath>
        <xpath expr="//div[@role='menuitem']" position="attributes">
            <attribute name="role"></attribute>
        </xpath>
        <!-- Remove role="menu" del <ul class="dropdown-menu"> que envuelve
             los items del dropdown — sin role en el padre, eliminar role
             en los hijos mantiene la consistencia ARIA (WAI-ARIA pattern
             de menu requiere ambos o ninguno). -->
        <xpath expr="//ul[@role='menu']" position="attributes">
            <attribute name="role"></attribute>
        </xpath>
        <!-- v18 añade role="presentation" a los <li> del submenu (leaf y
             dropdown, website_templates.xml:6,15 core v18). Coherente con
             la decisión C1 (sin menubar/menu, los li son list items
             normales), se limpian también (×2, ver nota de arriba). -->
        <xpath expr="//li[@role='presentation']" position="attributes">
            <attribute name="role"></attribute>
        </xpath>
        <xpath expr="//li[@role='presentation']" position="attributes">
            <attribute name="role"></attribute>
        </xpath>
    </template>

    <!-- C1 (extensión v18) — el <ul id="top_menu"> lleva ahora role="menu"
         en el propio core (website.navbar_nav, website_templates.xml:355
         v18), no solo los dropdown. Con li/a sin roles (template anterior),
         un role="menu" sin menuitem hijos dispara axe critical
         aria-required-children en TODAS las páginas (verificado runtime
         auditoría 2026-06-11 M6). Misma decisión C1: limpiar el role. -->
    <template id="navbar_nav_remove_role_menu"
              name="Header: remove ARIA role=menu from top_menu ul (C1 v18)"
              inherit_id="website.navbar_nav">
        <xpath expr="//ul[@role='menu']" position="attributes">
            <attribute name="role"></attribute>
        </xpath>
    </template>

    <!-- I2 — viewport sin user-scalable=no.
         Origen real del meta: `web.frontend_layout` (primary view que
         hereda de `web.layout` y añade el meta vía xpath, en
         `base/addons/web/views/webclient_templates.xml:469`):
           <meta name="viewport"
                 content="width=device-width, initial-scale=1, user-scalable=no"/>
         `user-scalable=no` viola WCAG 2.1 SC 1.4.4 (Resize Text) y
         1.4.10 (Reflow) — bloquea zoom para usuarios con visión reducida.

         Importante: el inherit_id correcto es `web.frontend_layout`
         (donde el meta SE AÑADE), NO `web.layout` (que no tiene meta).
         Probamos primero `web.layout` y dio ParseError porque el xpath
         no encontraba el nodo en el target view. -->
    <!-- v18: web.frontend_layout already emits viewport without user-scalable=no.
         This guard prevents regressions from upstream modules that might reintroduce it (audit a11y I2). -->
    <template id="viewport_allow_zoom"
              name="Head: viewport without user-scalable=no (I2)"
              inherit_id="web.frontend_layout">
        <xpath expr="//meta[@name='viewport']" position="replace">
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
        </xpath>
    </template>
</odoo>
