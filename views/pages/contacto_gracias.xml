<?xml version="1.0" encoding="utf-8"?>
<!--
    Post-v1 sub-bloque B — Página /contacto/gracias.
    Confirmación tras el POST del form de /contacto. Accesible solo
    via redirect 303 desde el controller (sin entrada de menú); el
    usuario llega aquí con el form ya enviado.

    website_indexed=False: no queremos que Google indexe la página de
    gracias (boilerplate sin valor SEO; además daría CTR ruido si
    aparece en SERP).

    Hero compacto (sin letter-stagger del /contacto): la animación
    elaborada queda fuera de tono para una página de confirmación;
    queremos que el usuario lea la confirmación sin que el sitio
    «celebre» el envío. Solo título + 1 línea + 2 botones secundarios.

    No incluye datos de contacto duplicados — ya los vio en /contacto.

    Slug EU /contacto/gracias se traduce vía url_code en la URL final;
    no necesitamos slug literal en EU per spec D2 (validación lingüística
    Q1 cubrirá si Avanzosc decide un slug-corto en euskera tipo /eskerrik).
-->
<odoo>
    <data>

        <template id="page_contacto_gracias" name="Avanzosc · Gracias">
            <t t-call="website.layout">
                <div id="wrap">
                    <div>
                        <section class="s_avanzosc_contacto_gracias">
                            <div class="container">
                                <div class="row">
                                    <div class="col-12 col-lg-8 offset-lg-2 s_avanzosc_contacto_gracias_inner">
                                        <h1 class="s_avanzosc_contacto_gracias_heading">¡Gracias!</h1>
                                        <p class="s_avanzosc_contacto_gracias_text">Hemos recibido tu consulta. Te responderemos en 24-48h laborables.</p>
                                        <div class="s_avanzosc_contacto_gracias_actions">
                                            <a href="/" class="btn btn-primary btn-lg">Volver al inicio</a>
                                            <a href="/#sectores" class="s_avanzosc_contacto_gracias_secondary">Ver soluciones</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        <!-- Plausible goal "Contact Form Submission" — Q4 / D25.
                             Gated por flag de sesión `contact_submitted`
                             que el controller `WebsiteAvanzoscContact.contacto_submit`
                             setea en el happy path antes del redirect 303
                             (NO en honeypot, NO en validation-failed).
                             Resolución deferred-q4-gracias-direct-access:
                             refresh, URL directa o navegación interna a
                             /gracias sin venir del form ya NO disparan el
                             goal. `pop` consume el flag — un solo disparo
                             por submit, robusto al refresh. t-set + t-if
                             defensivo: t-set evalúa una sola vez (evita
                             re-evaluación bajo paths de compilación QWeb).
                             Honeypot edge: bots rellenándolo Y ejecutando
                             JS Y burlando bot-filter Plausible — aceptable
                             (no setean flag, así que no disparan goal).
                             Guarded por `window.plausible` para adblock /
                             script bloqueado. Patrón inline DOMContentLoaded
                             canónico Plausible (snippet oficial 404). -->
                        <t t-nocache="Render depends on request.session flag set by /contacto submit controller; cache would serve the same Plausible goal trigger to every visitor.">
                            <t t-set="show_plausible_goal"
                               t-value="request.session.pop('contact_submitted', False)"/>
                            <t t-if="show_plausible_goal">
                                <script>
                                    document.addEventListener('DOMContentLoaded', function () {
                                        if (window.plausible) {
                                            window.plausible('Contact Form Submission');
                                        }
                                    });
                                </script>
                            </t>
                        </t>
                    </div>
                </div>
            </t>
        </template>

    </data>

    <data noupdate="1">

        <!-- noupdate=1 deliberado: protege is_published / website_indexed
             del reset por -u si en el futuro un admin los toca por UI.

             v14 usaba <field name="cache_time" eval="0"/> aquí para
             desactivar el cache per-page (3600 s default) y permitir
             que el gating de Plausible por request.session funcionase
             en refresh / URL directa.

             v18 ha eliminado el cache per-page de website.page (campo
             cache_time removido del modelo, _can_be_cached/
             _cached_response inertes). El opt-out se hace ahora vía
             t-nocache="..." en el sub-árbol QWeb session-dependent
             (ver template page_contacto_gracias arriba). -->
        <record id="page_contacto_gracias_record" model="website.page">
            <field name="name">Gracias</field>
            <field name="type">qweb</field>
            <field name="url">/contacto/gracias</field>
            <field name="view_id" ref="page_contacto_gracias"/>
            <field name="is_published" eval="True"/>
            <field name="website_indexed" eval="False"/>
        </record>

    </data>
</odoo>
