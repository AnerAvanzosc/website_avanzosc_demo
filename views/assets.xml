<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inyección de fuentes externas y Lucide CDN en <head>.
         Se hereda web.layout (raíz de toda la jerarquía de layouts de Odoo)
         para que las etiquetas aparezcan en <head> en todas las páginas del
         sitio web. Los <link rel="preconnect"> y el <script> de Lucide deben
         estar en <head> — no en el bundle web.assets_frontend — ya que el
         bundler concatena recursos locales y pasaría las URLs externas como
         CSS @import, perdiendo las directivas preconnect y el scope global de
         la variable `lucide`.
         Ref: spec §3.3 (pipeline de assets, punto 1-2), CLAUDE.md §9.4, §9.7. -->
    <template id="head_external_assets"
              name="website_avanzosc_demo head: Google Fonts + Lucide + GSAP + ScrollTrigger + Splitting + Lenis"
              inherit_id="web.layout">
        <!-- Ancla: después del último elemento de <head> (position inside
             añade al final del contenedor, antes del cierre </head>).
             Esto garantiza que nuestros recursos externos se cargan en <head>
             independientemente del orden en que otras herencias modifiquen
             la sección head.
             Por qué `position="inside"` y no un anchor más específico
             (p.ej. `//head/script[@id="..."] position="after"`): la
             estructura de <head> en `web.layout` v14 es estable y termina
             con `<t t-raw="head or ''"/>`, por lo que `inside` resuelve
             siempre al final del contenedor. Anchors específicos a IDs
             concretos serían más frágiles ante futuros cambios menores
             de Odoo. -->
        <xpath expr="//head" position="inside">
            <!-- 0. Flag js-anim (L2.4, cierra D19) — inline síncrono: la
                 clase existe ANTES del primer paint (ejecuta durante el
                 parse), así que ocultar los estados pre-anim del hero bajo
                 html.js-anim es atómico — cero flicker show-then-hide (el
                 riesgo que descartó la Propuesta A en D19 era el orden
                 inverso: revelar tarde). Sin JS la clase no se añade y el
                 bloque de texto del hero queda visible por defecto. -->
            <script type="text/javascript">document.documentElement.classList.add('js-anim');</script>

            <!-- Apple touch icon (favicon set «Av» azul, lote favicon
                 2026-06-16). El <link rel="icon"> de la pestaña lo emite el
                 core desde website.favicon (seteado en
                 models/website_meta_sync.py); este link cubre el caso que
                 website.favicon NO cubre: «Añadir a pantalla de inicio» en
                 iOS, que requiere apple-touch-icon 180×180. Servido como
                 estático del módulo. NO añadimos manifest PWA (192/512): el
                 sitio no declara un web app manifest, los links quedarían
                 huérfanos; los PNGs 192/512 quedan en static/ por si se
                 añade manifest en el futuro. -->
            <link rel="apple-touch-icon" sizes="180x180"
                  href="/website_avanzosc_demo/static/src/img/favicon-180.png"/>

            <!-- 1. Google Fonts — preconnect (mejora TTFB de las fuentes).
                 Nota: NO añadimos preconnect para `cdnjs.cloudflare.com` ni
                 `cdn.jsdelivr.net`. Los <script> y <link rel="stylesheet">
                 que apuntan a esos CDNs son render-blocking en <head>, así
                 que el navegador abre conexión inmediatamente; un preconnect
                 no aportaría diferencia perceptible. Re-evaluar si en
                 futuras tareas (hero/timeline) el first-paint timing pasa a
                 depender críticamente de esas librerías. -->
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>

            <!-- 2. Google Fonts — stylesheet:
                 - Space Grotesk 500, 600 (headings H1-H3, CLAUDE.md §9.4)
                 - Inter 400, 500, 600 (body copy, CLAUDE.md §9.4)
                 - JetBrains Mono 400 (código/datos técnicos, CLAUDE.md §9.4) -->
            <link rel="stylesheet"
                  href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600&amp;family=Inter:wght@400;500;600&amp;family=JetBrains+Mono:wght@400&amp;display=swap"/>

            <!-- 3. Splitting.js 1.0.6 CSS — base styles for split word/char nodes.
                 Debe ir en <head> con las demás hojas de estilo para que los
                 estilos estén disponibles antes del primer paint.
                 Nota: el plan task 0.4 lista `splitting.min.js + splitting.css`
                 agrupados después de ScrollTrigger. Aquí se adelanta el CSS
                 (posición 3) por delante de los <script> JS para respetar la
                 convención CSS-antes-de-JS en <head> (evita reflows / FOUC
                 sobre los nodos split). El JS de Splitting sigue en posición
                 7, después de GSAP/ScrollTrigger.
                 Ref: spec §9.1 tabla de versiones. -->
            <link rel="stylesheet"
                  href="https://cdn.jsdelivr.net/npm/splitting@1.0.6/dist/splitting.css"/>

            <!-- 4. Lucide Icons 0.453.0 UMD build — expone el global `lucide`.
                 CONTRATO DE ORDEN (L2.3, lote perf 2026-06-11): los 5 CDN
                 llevan `defer` — ejecutan en orden documental como muy
                 tarde en DOMContentLoaded. Nuestros widgets viven en
                 `web.assets_frontend`, que v18 sirve como bundle LAZY
                 (`data-src`, inyectado por el lazyloader del bundle
                 minimal DESPUÉS de `load`) → siempre posterior a DCL: los
                 globals están garantizados cuando los widgets arrancan,
                 sin guards adicionales. Medido baseline: blocking CDN
                 0,5-1,5s estimados en first-visit móvil real; con defer el
                 primer paint no espera a los CDN.
                 RIESGO RESIDUAL: si algún día se registra JS propio en un
                 bundle EAGER (p.ej. assets_frontend_minimal), ese código
                 NO puede asumir los globals — revisar este contrato.
                 La llamada lucide.createIcons() vive en main.js dentro de
                 publicWidget.AvanzoscRoot.start().
                 Ref: CLAUDE.md §9.7, spec §9 tabla de versiones. -->
            <script type="text/javascript" defer="defer"
                    src="https://cdn.jsdelivr.net/npm/lucide@0.453.0/dist/umd/lucide.min.js"/>

            <!-- 5. GSAP 3.12.5 — core. Debe cargar antes de cualquier plugin
                 (defer preserva el orden documental: gsap → ScrollTrigger).
                 Ref: spec §9.1 tabla de versiones. -->
            <script type="text/javascript" defer="defer"
                    src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"/>

            <!-- 6. GSAP ScrollTrigger 3.12.5 — re-introducido para Pieza E v3
                 (timeline scrolljack pin + scrub continuo SIN snap). Bridge
                 con Lenis configurado en main.js (scroller-proxy + lenis.on
                 scroll → ScrollTrigger.update). Sólo aplica desktop+motion-on
                 (gating en timeline.js); mobile/reduced-motion conserva D
                 base CSS scroll-snap nativo sin pin.
                 Retirada brevemente en `61600ff` (sin consumidor); restaurada
                 al cerrar `deferred-timeline-scrolljacking` con approach H
                 (decisions-log §6).
                 Ref: D27 (Pieza A), Pieza E v3 brief sesión 2026-05-05. -->
            <script type="text/javascript" defer="defer"
                    src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"/>

            <!-- 7. Splitting.js 1.0.6 JS — reemplazo MIT de GSAP SplitText.
                 Expone el global `Splitting`. Usado en hero para split por letra.
                 Ref: spec §9.1 (nota: descarte de SplitText en favor de Splitting.js MIT). -->
            <script type="text/javascript" defer="defer"
                    src="https://cdn.jsdelivr.net/npm/splitting@1.0.6/dist/splitting.min.js"/>

            <!-- 8. Lenis 1.0.42 — smooth scroll global. Expone el global `Lenis`.
                 La instancia se crea en Task 0.6; aquí solo se registra la librería.
                 Ref: spec §9.1 tabla de versiones, CLAUDE.md §5 (smooth scroll con Lenis). -->
            <script type="text/javascript" defer="defer"
                    src="https://cdn.jsdelivr.net/npm/@studio-freight/lenis@1.0.42/dist/lenis.min.js"/>
        </xpath>
    </template>

    <!-- ============================================================
         Plausible Analytics — Q4, D25.
         Privacy-friendly analytics: sin cookies, sin localStorage, sin
         huella personal → no requiere consent banner ni encaja en el
         scope ePrivacy de cookies (RGPD-friendly por diseño). Hosted EU.
         Script combinado:
           - outbound-links: tracking automático de clicks a dominios externos.
           - 404: tracking de páginas 404 (dispara `plausible('404')`
             desde una página /404 si la sirviéramos; en v1 Odoo ya
             devuelve su 404 estándar — el flag queda activo por si
             se decide servir una /404 custom en futuro).
         URL canónica verificada empíricamente (sesión 2026-05-04):
         orden alfabético en filename — `script.404.outbound-links.js`
         (200) sí existe; `script.outbound-links.404.js` da 404. La
         convención de Plausible es alfanumérica.
         data-domain="avanzosc.es" — dominio canónico final post-switchover.
         Durante QA en `nueva.avanzosc.es` el script reportará al mismo
         site Plausible (mismatched hostname → eventos suprimidos por el
         propio script Plausible cuando el dominio del navegador no coincide
         exactamente con data-domain — comportamiento OK para no contaminar
         métricas con tráfico de pre-producción).
         Goal "Contact Form Submission" se dispara desde
         `views/pages/contacto_gracias.xml` (inline DOMContentLoaded).
         Ref: CLAUDE.md §11 D25, decisions-log.md §7.
         ============================================================ -->
    <!-- ============================================================
         JSON-LD Organization/LocalBusiness — M10 (auditoría 2026-06-11).
         Un único nodo con @type dual (entidad única, evita duplicar la
         organización ante Google). Datos factuales tomados de la columna
         de contacto (views/pages/contacto.xml) y el footer:
           - nombre + CIF: footer legal strip (© Avanzosc S.L. — CIF ...).
           - dirección/teléfono/email/horario: /contacto.
           - url: dominio canónico final post-switchover (mismo criterio
             que data-domain de Plausible, abajo).
         Sin `logo`: no hay asset definitivo aún (deuda A2/«SVG del
         logo»); añadir cuando exista. `taxID` (no vatID): B20875340 es
         el CIF tal cual figura en el footer, sin prefijo ES inventado.
         Estático e idéntico en ES/EU (datos de entidad, no copy).
         ============================================================ -->
    <template id="head_jsonld_organization"
              name="website_avanzosc_demo head: JSON-LD Organization/LocalBusiness"
              inherit_id="web.layout">
        <xpath expr="//head" position="inside">
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": ["Organization", "LocalBusiness"],
                "name": "Avanzosc S.L.",
                "url": "https://avanzosc.es",
                "email": "comercial@avanzosc.es",
                "telephone": "+34943026902",
                "taxID": "B20875340",
                "address": {
                    "@type": "PostalAddress",
                    "streetAddress": "Av. Julio Urkijo 34 bajo",
                    "postalCode": "20720",
                    "addressLocality": "Azkoitia",
                    "addressRegion": "Gipuzkoa",
                    "addressCountry": "ES"
                },
                "openingHoursSpecification": [
                    {
                        "@type": "OpeningHoursSpecification",
                        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
                        "opens": "08:30",
                        "closes": "14:00"
                    },
                    {
                        "@type": "OpeningHoursSpecification",
                        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
                        "opens": "15:00",
                        "closes": "17:30"
                    }
                ]
            }
            </script>
        </xpath>
    </template>

    <template id="head_plausible"
              name="website_avanzosc_demo head: Plausible Analytics"
              inherit_id="web.layout">
        <xpath expr="//head" position="inside">
            <script defer="defer"
                    data-domain="avanzosc.es"
                    src="https://plausible.io/js/script.404.outbound-links.js"/>
        </xpath>
    </template>
</odoo>
