<?xml version="1.0" encoding="utf-8"?>
<!--
    s_avanzosc_timeline — Pieza D base + Pieza E v3 (approach H).
    Ref: spec §6.8, plan §3.8, CLAUDE.md §11 «Trayectoria», decisions-log
    §6 deferred-timeline-scrolljacking (cierre con approach H autorizado).

    Mecánica dual:
      - Pieza D base (mobile / reduced-motion / GSAP+ST ausentes): carrusel
        scroll-snap CSS x mandatory horizontal. Drag/swipe libre, snap por
        hito al soltar. Flechas prev/next + 8 dots indicators clicables.
        Wheel de página vertical (Lenis) intacto.
      - Pieza E v3 (desktop ≥768 + motion-on + gsap+ScrollTrigger): la sección
        se pinea, los items se animan continuamente en función del progress
        (sin clases discretas, sin snap, sin idx changes durante scrub).
        Approach H: protagonista fluctuante por |delta| más cercano al
        centro virtual; flechas y dots route via lenis.scrollTo a la
        posición pin del idx target (snap discreto SOLO en click, no en
        wheel).

    Estructura HTML compartida entre ambos modos. JS toggling de la clase
    `.is-st-active` en `.s_avanzosc_timeline_carousel` activa/desactiva
    el bloque slot mode del SCSS (scoped @media >=768px). Sin clases
    is-slot-* en el HTML — JS aplica estilos inline frame-by-frame.

    ARIA:
      - role="region" + tabindex en `.s_avanzosc_timeline_track_wrap` (NO
        en la `<ul>` para no romper su rol implícito list).
      - dots indicadores: `aria-current="step"` en el activo (actualizado
        al cambiar idx en onUpdate). `aria-label` per-dot con año del hito.
      - Flechas: `aria-label="Hito anterior" / "siguiente"`. `disabled`
        cuando idx en extremo del rango.
      - slot_dot decorativos: `aria-hidden="true"` (puramente visual).

    Anchor `#timeline` accesible desde "Ver casos de éxito" / sectoriales.
-->
<odoo>
    <template id="s_avanzosc_timeline" name="Avanzosc · Timeline">
        <section id="timeline" class="s_avanzosc_timeline" data-name="Avanzosc Timeline">
            <div class="container">
                <h2 class="s_avanzosc_timeline_heading">Trayectoria</h2>
                <p class="s_avanzosc_timeline_intro">Desde 2008, antes incluso de que se llamara Odoo.</p>

                <div class="s_avanzosc_timeline_carousel">
                    <button type="button"
                            class="s_avanzosc_timeline_arrow s_avanzosc_timeline_arrow--prev"
                            aria-label="Hito anterior"
                            disabled="disabled">‹</button>
                    <button type="button"
                            class="s_avanzosc_timeline_arrow s_avanzosc_timeline_arrow--next"
                            aria-label="Hito siguiente">›</button>

                    <!-- 8 milestone-dots — uno por hito (Pieza E v3 ajuste).
                         Sólo visibles cuando .is-st-active (modo slot mode
                         desktop). Distribución: idx 0 en left:5%, idx 7 en
                         left:95%, espaciado lineal 90/7 ≈ 12.857%/step.
                         Inset 5%/95% match con la línea conectora — endpoints
                         renderen completos sin clip por overflow:hidden.
                         Estado base: var(neutral-300); estado .is-passed
                         (set por JS cuando progress >= idx/(N-1)):
                         var(brand-primary). Transition CSS 200ms suaviza
                         el cambio. CSS variable idx (inline style) alimenta
                         el cálculo de left en la regla SCSS, evitando 8
                         reglas distintas. -->
                    <t t-foreach="range(8)" t-as="i">
                        <span class="s_avanzosc_timeline_milestone_dot"
                              t-att-data-idx="i"
                              t-attf-style="--idx: #{i}"
                              aria-hidden="true"></span>
                    </t>

                    <div class="s_avanzosc_timeline_track_wrap"
                         tabindex="0"
                         role="region"
                         aria-label="Trayectoria Avanzosc 2008-2024">
                        <ul class="s_avanzosc_timeline_items">
                            <li class="s_avanzosc_timeline_item">
                                <span class="s_avanzosc_timeline_dot"></span>
                                <span class="s_avanzosc_timeline_year">2008</span>
                                <h3 class="s_avanzosc_timeline_title">Fundación en Azkoitia</h3>
                                <p class="s_avanzosc_timeline_desc">Inicio con OpenERP 5. Primeros desarrollos para industria local.</p>
                            </li>
                            <li class="s_avanzosc_timeline_item">
                                <span class="s_avanzosc_timeline_dot"></span>
                                <span class="s_avanzosc_timeline_year">2011</span>
                                <h3 class="s_avanzosc_timeline_title">Primeros módulos OCA</h3>
                                <p class="s_avanzosc_timeline_desc">Módulos de fabricación publicados en la comunidad. Cultura OCA en el equipo.</p>
                            </li>
                            <li class="s_avanzosc_timeline_item">
                                <span class="s_avanzosc_timeline_dot"></span>
                                <span class="s_avanzosc_timeline_year">2014</span>
                                <h3 class="s_avanzosc_timeline_title">Migración a Odoo 8</h3>
                                <p class="s_avanzosc_timeline_desc">Salto OpenERP → Odoo 8. Re-escritura de módulos propios al ORM nuevo.</p>
                            </li>
                            <li class="s_avanzosc_timeline_item">
                                <span class="s_avanzosc_timeline_dot"></span>
                                <span class="s_avanzosc_timeline_year">2017</span>
                                <h3 class="s_avanzosc_timeline_title">Integraciones MES / SCADA</h3>
                                <p class="s_avanzosc_timeline_desc">Conector PLC vía OCA/connector_mes. Industrial 4.0 deja de ser teoría.</p>
                            </li>
                            <li class="s_avanzosc_timeline_item">
                                <span class="s_avanzosc_timeline_dot"></span>
                                <span class="s_avanzosc_timeline_year">2020</span>
                                <h3 class="s_avanzosc_timeline_title">Soporte y formación remota</h3>
                                <p class="s_avanzosc_timeline_desc">Helpdesk remoto a escala. Webinars técnicos. Las academias entran como sector.</p>
                            </li>
                            <li class="s_avanzosc_timeline_item">
                                <span class="s_avanzosc_timeline_dot"></span>
                                <span class="s_avanzosc_timeline_year">2022</span>
                                <h3 class="s_avanzosc_timeline_title">500+ módulos publicados</h3>
                                <p class="s_avanzosc_timeline_desc">Cruzamos los 500 módulos contribuidos. Reconocimiento OCA estable.</p>
                            </li>
                            <li class="s_avanzosc_timeline_item">
                                <span class="s_avanzosc_timeline_dot"></span>
                                <span class="s_avanzosc_timeline_year">2024</span>
                                <h3 class="s_avanzosc_timeline_title">Kit Consulting Red.es</h3>
                                <p class="s_avanzosc_timeline_desc">Habilitados como asesores oficiales del programa estatal.</p>
                            </li>
                            <li class="s_avanzosc_timeline_item">
                                <span class="s_avanzosc_timeline_dot"></span>
                                <span class="s_avanzosc_timeline_year">Hoy</span>
                                <h3 class="s_avanzosc_timeline_title">4 sectores, equipo STEM</h3>
                                <p class="s_avanzosc_timeline_desc">Industrial, distribución, servicios, academias. Mayoría STEM femenina.</p>
                            </li>
                        </ul>
                    </div>

                    <div class="s_avanzosc_timeline_dots" aria-label="Indicadores de hito">
                        <button type="button" class="s_avanzosc_timeline_dot_indicator is-active" data-target-index="0" aria-label="Ir al hito 1: 2008" aria-current="step"></button>
                        <button type="button" class="s_avanzosc_timeline_dot_indicator" data-target-index="1" aria-label="Ir al hito 2: 2011"></button>
                        <button type="button" class="s_avanzosc_timeline_dot_indicator" data-target-index="2" aria-label="Ir al hito 3: 2014"></button>
                        <button type="button" class="s_avanzosc_timeline_dot_indicator" data-target-index="3" aria-label="Ir al hito 4: 2017"></button>
                        <button type="button" class="s_avanzosc_timeline_dot_indicator" data-target-index="4" aria-label="Ir al hito 5: 2020"></button>
                        <button type="button" class="s_avanzosc_timeline_dot_indicator" data-target-index="5" aria-label="Ir al hito 6: 2022"></button>
                        <button type="button" class="s_avanzosc_timeline_dot_indicator" data-target-index="6" aria-label="Ir al hito 7: 2024"></button>
                        <button type="button" class="s_avanzosc_timeline_dot_indicator" data-target-index="7" aria-label="Ir al hito 8: Hoy"></button>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
