<?xml version="1.0" encoding="utf-8"?>
<!--
    Task 3.9 — s_avanzosc_equipo snippet.
    Ref: spec §6.9, plan §3.9, CLAUDE.md §9.1 pilar 3 «Equipo único».

    F2 (post-F1.2 v2): SVG abstracto de placeholder REEMPLAZADO por grid
    de 8 tarjetas con el equipo real (Ana Juaristi CEO + 7 técnicos).
    Cada tarjeta lleva avatar circular con iniciales, nombre, rol y
    especialidad. Ana lleva clase `is-ceo` (avatar brand-primary + badge
    CEO).

    Layout:
      - Top: heading + paragraph (intro narrativa).
      - Middle: grid 4×2 desktop / 2×4 tablet / 1×8 mobile.
      - Bottom: 4 stats clave (sin cambios respecto a v1).

    Reveal padre: la sección entera mantiene `data-avanzosc-reveal=""`
    (IO 0.2, opacity+translateY 600ms expo). Las 8 tarjetas heredan
    el reveal del padre — sin stagger individual.

    Hover dramático: gestionado por `equipo.js` widget reusando el util
    `hover_orchestrator` (mismo patrón que F1.1 v2 caso_exito).
    Toggle .is-hovered + data-hover-active en el grid.
-->
<odoo>
    <template id="s_avanzosc_equipo" name="Avanzosc · Equipo">
        <section id="equipo" class="s_avanzosc_equipo" data-name="Avanzosc Equipo" data-avanzosc-reveal="">
            <div class="container">

                <!-- Intro: heading + paragraph centered. -->
                <div class="row">
                    <div class="col-12 col-lg-9 mx-auto s_avanzosc_equipo_text">
                        <h2 class="s_avanzosc_equipo_heading">Quiénes lo construyen</h2>
                        <p class="s_avanzosc_equipo_paragraph">Equipo STEM con base en Azkoitia, Gipuzkoa. Mayoría femenina en un sector dominado por hombres. Programadoras, consultoras funcionales y técnicas de soporte. Contribuimos a la OCA y formamos a la siguiente generación a través de las academias.</p>
                    </div>
                </div>

                <!-- Grid 8 tarjetas. -->
                <div class="row">
                    <div class="col-12">
                        <div class="s_avanzosc_equipo_grid">

                            <article class="s_avanzosc_equipo_card is-ceo">
                                <div class="s_avanzosc_equipo_card_avatar">
                                    <span class="s_avanzosc_equipo_card_initials">AJ</span>
                                </div>
                                <div class="s_avanzosc_equipo_card_meta">
                                    <span class="s_avanzosc_equipo_card_badge" aria-hidden="true">CEO</span>
                                    <h3 class="s_avanzosc_equipo_card_name">Ana Juaristi</h3>
                                    <p class="s_avanzosc_equipo_card_role">Fundadora</p>
                                    <p class="s_avanzosc_equipo_card_specialty">Dirección y Odoo MRP</p>
                                </div>
                            </article>

                            <article class="s_avanzosc_equipo_card">
                                <div class="s_avanzosc_equipo_card_avatar">
                                    <span class="s_avanzosc_equipo_card_initials">RD</span>
                                </div>
                                <div class="s_avanzosc_equipo_card_meta">
                                    <h3 class="s_avanzosc_equipo_card_name">Ramón Díez</h3>
                                    <p class="s_avanzosc_equipo_card_role">Director comercial</p>
                                    <p class="s_avanzosc_equipo_card_specialty">Ventas y ofertas</p>
                                </div>
                            </article>

                            <article class="s_avanzosc_equipo_card">
                                <div class="s_avanzosc_equipo_card_avatar">
                                    <span class="s_avanzosc_equipo_card_initials">OA</span>
                                </div>
                                <div class="s_avanzosc_equipo_card_meta">
                                    <h3 class="s_avanzosc_equipo_card_name">Olatz Aranguren</h3>
                                    <p class="s_avanzosc_equipo_card_role">Consultora</p>
                                    <p class="s_avanzosc_equipo_card_specialty">Contabilidad y administración</p>
                                </div>
                            </article>

                            <article class="s_avanzosc_equipo_card">
                                <div class="s_avanzosc_equipo_card_avatar">
                                    <span class="s_avanzosc_equipo_card_initials">ADF</span>
                                </div>
                                <div class="s_avanzosc_equipo_card_meta">
                                    <h3 class="s_avanzosc_equipo_card_name">Alfredo De la F.</h3>
                                    <p class="s_avanzosc_equipo_card_role">Analista programador</p>
                                    <p class="s_avanzosc_equipo_card_specialty">Coordinación técnica</p>
                                </div>
                            </article>

                            <article class="s_avanzosc_equipo_card">
                                <div class="s_avanzosc_equipo_card_avatar">
                                    <span class="s_avanzosc_equipo_card_initials">OC</span>
                                </div>
                                <div class="s_avanzosc_equipo_card_meta">
                                    <h3 class="s_avanzosc_equipo_card_name">Oihane Crucelaegi</h3>
                                    <p class="s_avanzosc_equipo_card_role">Analista programadora</p>
                                    <p class="s_avanzosc_equipo_card_specialty">Backend y APIs</p>
                                </div>
                            </article>

                            <article class="s_avanzosc_equipo_card">
                                <div class="s_avanzosc_equipo_card_avatar">
                                    <span class="s_avanzosc_equipo_card_initials">BA</span>
                                </div>
                                <div class="s_avanzosc_equipo_card_meta">
                                    <h3 class="s_avanzosc_equipo_card_name">Berezi Amubieta</h3>
                                    <p class="s_avanzosc_equipo_card_role">Analista programadora</p>
                                    <p class="s_avanzosc_equipo_card_specialty">Verticales sectoriales</p>
                                </div>
                            </article>

                            <article class="s_avanzosc_equipo_card">
                                <div class="s_avanzosc_equipo_card_avatar">
                                    <span class="s_avanzosc_equipo_card_initials">LE</span>
                                </div>
                                <div class="s_avanzosc_equipo_card_meta">
                                    <h3 class="s_avanzosc_equipo_card_name">Lucía Echeverría</h3>
                                    <p class="s_avanzosc_equipo_card_role">Programadora</p>
                                    <p class="s_avanzosc_equipo_card_specialty">Desarrollo de módulos</p>
                                </div>
                            </article>

                            <article class="s_avanzosc_equipo_card">
                                <div class="s_avanzosc_equipo_card_avatar">
                                    <span class="s_avanzosc_equipo_card_initials">AG</span>
                                </div>
                                <div class="s_avanzosc_equipo_card_meta">
                                    <h3 class="s_avanzosc_equipo_card_name">Ane Gurruchaga</h3>
                                    <p class="s_avanzosc_equipo_card_role">Programadora</p>
                                    <p class="s_avanzosc_equipo_card_specialty">Migración de BBDD</p>
                                </div>
                            </article>

                        </div>
                    </div>
                </div>

                <!-- Stats clave. Sin cambios respecto a v1. -->
                <div class="row">
                    <div class="col-12 col-lg-9 mx-auto">
                        <ul class="s_avanzosc_equipo_stats">
                            <li class="s_avanzosc_equipo_stat">
                                <span class="s_avanzosc_equipo_stat_label">Equipo</span>
                                <span class="s_avanzosc_equipo_stat_value">8 personas</span>
                            </li>
                            <li class="s_avanzosc_equipo_stat">
                                <span class="s_avanzosc_equipo_stat_label">Composición</span>
                                <span class="s_avanzosc_equipo_stat_value">Mayoría STEM femenina</span>
                            </li>
                            <li class="s_avanzosc_equipo_stat">
                                <span class="s_avanzosc_equipo_stat_label">OCA</span>
                                <span class="s_avanzosc_equipo_stat_value">Contribuyentes activos</span>
                            </li>
                            <li class="s_avanzosc_equipo_stat">
                                <span class="s_avanzosc_equipo_stat_label">Sede</span>
                                <span class="s_avanzosc_equipo_stat_value">Azkoitia, Gipuzkoa</span>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
        </section>
    </template>
</odoo>
