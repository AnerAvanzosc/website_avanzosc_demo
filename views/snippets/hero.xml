<?xml version="1.0" encoding="utf-8"?>
<!--
    Task 3.10 — s_avanzosc_hero snippet.
    Ref: spec §6.1 §9.2, plan §3.10, CLAUDE.md §11 D2 «Claim de la home»
    (validado, NO TRANSLATION DRAFT) + decisiones B-G sesión 2026-04-28.

    Primera sección de la home (sección 1 funnel). Captura atención + claim
    diferenciador + 2 CTAs hacia el funnel.

    Decisiones aplicadas (CLAUDE.md §11 hero deferred B-G):
      A — claim ES/EU validados D2 (idénticos al footer brand col).
      B — subtítulo: «Migración OpenUpgrade, módulos OCA y localización
          fiscal española. Para industria, distribución, servicios y
          academias.»
      C — 2 CTAs: «Ver soluciones» → #sectores, «Hablar con nosotros»
          → /contacto.
      D — Background blanco neutral-0, headline neutral-900 (CLAUDE.md
          §9.8 jerarquía por tamaño antes que por color).
      E — SIN imagen en v1. Comentario TODO #spec-q8 marca el punto donde
          insertar foto/illustration cuando se cierre la sesión fotográfica.
      F — min-height: 600px desktop, 480px mobile (en _hero.scss).
      G — animación completa: Splitting.js letter-split + GSAP timeline.

    NO en builder (D4).
-->
<odoo>
    <template id="s_avanzosc_hero" name="Avanzosc · Hero">
        <!--
            Parametrización (Phase 5): cada llamador puede sobrescribir
            los 6 fragmentos de copy via `<t t-call>` body con `<t t-set>`.
            Forma t-set body (no t-value) preserva el contenido como
            QWeb-rendered text, lo que mantiene la traducibilidad
            automática en eu.po (extracción del extractor de Odoo
            recoge el texto del body como msgid).

            Defaults aquí = los valores de la home Phase 4. Cualquier
            llamador sin body usa los defaults. Sectoriales (Phase 5)
            sobrescriben con copy específico por sector.
        -->
        <t t-if="not hero_claim">
            <t t-set="hero_claim">Odoo industrial de verdad, desde 2008.</t>
        </t>
        <t t-if="not hero_subtitle">
            <t t-set="hero_subtitle">Migración OpenUpgrade, módulos OCA y localización fiscal española. Para industria, distribución, servicios y academias.</t>
        </t>
        <t t-if="not hero_cta_primary_text">
            <t t-set="hero_cta_primary_text">Ver soluciones</t>
        </t>
        <t t-if="not hero_cta_primary_url">
            <t t-set="hero_cta_primary_url">#sectores</t>
        </t>
        <t t-if="not hero_cta_secondary_text">
            <t t-set="hero_cta_secondary_text">Hablar con nosotros</t>
        </t>
        <t t-if="not hero_cta_secondary_url">
            <t t-set="hero_cta_secondary_url">/contacto</t>
        </t>

        <section class="s_avanzosc_hero" data-name="Avanzosc Hero">
            <!-- Pieza A — Hero decoration (technical blueprint, sutil).
                 2 layers absolutamente posicionados detrás del contenido,
                 pointer-events:none + aria-hidden=true para que no
                 interfieran con interaction ni screen readers. El claim
                 sigue siendo el LCP element semántico.
                 Layer 1 (atrás): grid de puntos vía CSS radial-gradient
                 + mask que desvanece el centro.
                 Layer 2 (delante): SVG inline con 3 trazos asimétricos
                 que enmarcan el texto sin cruzarlo.
                 Parallax + entrance fade gestionados desde hero.js. -->
            <div class="s_avanzosc_hero_grid" aria-hidden="true"></div>
            <svg class="s_avanzosc_hero_lines"
                 viewBox="0 0 100 100"
                 preserveAspectRatio="none"
                 aria-hidden="true"
                 focusable="false">
                <!-- Main: long curve bottom, passing under text area. -->
                <path class="s_avanzosc_hero_lines_main"
                      d="M -2 78 Q 50 90 102 72"
                      fill="none" stroke="currentColor" stroke-width="1"
                      vector-effect="non-scaling-stroke"/>
                <!-- Secondary 1: short diagonal top-right. -->
                <path class="s_avanzosc_hero_lines_secondary"
                      d="M 95 8 L 70 28"
                      fill="none" stroke="currentColor" stroke-width="1"
                      vector-effect="non-scaling-stroke"/>
                <!-- Secondary 2: short diagonal top-left (hidden mobile). -->
                <path class="s_avanzosc_hero_lines_secondary s_avanzosc_hero_lines_secondary_topleft"
                      d="M -2 25 L 18 18"
                      fill="none" stroke="currentColor" stroke-width="1"
                      vector-effect="non-scaling-stroke"/>
            </svg>
            <!-- Pieza A v3 — Anotaciones técnicas tipo CAD (HTML+CSS positioned).
                 Tras 2 intentos descartados (v3 estirado 377bd65 que distorsionaba
                 el texto via SVG preserveAspectRatio="none", y v3 SVG 7824b1e que
                 con preserveAspectRatio="slice" recortaba anotaciones a los bordes
                 según viewport — distintos viewports veían distintas anotaciones).

                 Approach final: cada anotación es un <div> position:absolute con
                 top/left/right/bottom en %. NO viewBox global. Cada anotación se
                 renderiza en su posición % en TODOS los viewports.

                 Container hermano de _grid + _lines, dentro de .s_avanzosc_hero.
                 z-index 1 (mismo que _lines), DOM order POSTERIOR → pinta encima.
                 aria-hidden=true (decoración pura).

                 Mini-SVGs locales por anotación (con su propio viewBox pequeño)
                 para los gráficos de líneas (cotas, cross-marks, ticks). Texto
                 SIEMPRE en <span class="cad-text"> HTML — texto en HTML+CSS no
                 se estira con el contenedor.

                 Hover individual: JS pickActiveAnnotation calcula distancia
                 cursor↔rect de cada <div>; rect expandido por padding 30px;
                 closest wins con tiebreak menor-área. Solo UNA <div>.is-glow
                 simultáneamente. mouseleave → todas off.

                 Mouse parallax v2: el container hereda var(mouse-rx/-ry) (mismo
                 magnitud que _lines) + var(scroll-y). CSS combina via transform.

                 Mobile <992px: subset reducido (header-spec + dim-h + cross-a1).
                 Resto display:none. -->
            <div class="s_avanzosc_hero_annotations" aria-hidden="true">
                <div class="cad-annotation cad-annotation--mobile-keep" data-anno="header-spec">
                    <span class="cad-text cad-show-desktop">v.14  ISO 9001  OCA</span>
                    <span class="cad-text cad-show-mobile">v.14  OCA</span>
                </div>

                <div class="cad-annotation cad-dim-h" data-anno="dim-h">
                    <span class="cad-text">26.4</span>
                    <svg class="cad-svg" viewBox="0 0 120 8" width="120" height="8" focusable="false">
                        <line x1="0" y1="4" x2="120" y2="4"/>
                        <line x1="0" y1="0" x2="0" y2="8"/>
                        <line x1="120" y1="0" x2="120" y2="8"/>
                    </svg>
                </div>

                <div class="cad-annotation cad-dim-v" data-anno="dim-v">
                    <span class="cad-text">Ø 18.0</span>
                    <svg class="cad-svg" viewBox="0 0 8 100" width="8" height="100" focusable="false">
                        <line x1="4" y1="0" x2="4" y2="100"/>
                        <line x1="0" y1="0" x2="8" y2="0"/>
                        <line x1="0" y1="100" x2="8" y2="100"/>
                    </svg>
                </div>

                <div class="cad-annotation cad-cross" data-anno="cross-a1">
                    <svg class="cad-svg" viewBox="0 0 14 14" width="14" height="14" focusable="false">
                        <line x1="0" y1="7" x2="14" y2="7"/>
                        <line x1="7" y1="0" x2="7" y2="14"/>
                    </svg>
                    <span class="cad-text">A1</span>
                </div>

                <div class="cad-annotation cad-cross" data-anno="cross-b2">
                    <svg class="cad-svg" viewBox="0 0 14 14" width="14" height="14" focusable="false">
                        <line x1="0" y1="7" x2="14" y2="7"/>
                        <line x1="7" y1="0" x2="7" y2="14"/>
                    </svg>
                    <span class="cad-text">B2</span>
                </div>

                <div class="cad-annotation cad-ticks" data-anno="ticks-085">
                    <svg class="cad-svg" viewBox="0 0 80 8" width="80" height="8" focusable="false">
                        <line x1="0" y1="0" x2="0" y2="8"/>
                        <line x1="40" y1="0" x2="40" y2="8"/>
                        <line x1="80" y1="0" x2="80" y2="8"/>
                    </svg>
                    <span class="cad-text">0.85</span>
                </div>

                <div class="cad-annotation cad-annotation--mobile-keep" data-anno="footer-coord">
                    <span class="cad-text cad-show-desktop">X 0.000  Y 0.000</span>
                    <span class="cad-text cad-show-mobile">X 0.000</span>
                </div>

                <div class="cad-annotation cad-annotation--mobile-keep cad-center-x" data-anno="footer-scale">
                    <span class="cad-text">SCALE 1:1</span>
                </div>

                <!-- Crosshair P.0: cruz con gap central + dot, centro-derecha
                     del hero. Mockup approved del orquestador. -->
                <div class="cad-annotation cad-crosshair" data-anno="crosshair-p0">
                    <svg class="cad-crosshair-svg" viewBox="0 0 40 40" width="44" height="44" focusable="false">
                        <line x1="0" y1="20" x2="14" y2="20"/>
                        <line x1="26" y1="20" x2="40" y2="20"/>
                        <line x1="20" y1="0" x2="20" y2="14"/>
                        <line x1="20" y1="26" x2="20" y2="40"/>
                        <circle cx="20" cy="20" r="2"/>
                    </svg>
                    <span class="cad-text">P.0</span>
                </div>

                <!-- Mini axis XYZ: 3 ejes saliendo de un origen + dot + labels.
                     Excepción a "texto siempre HTML" — los labels X Y Z viven
                     dentro del mini-SVG como <text> inline al gráfico.
                     Reusado en mobile con override de width/height + posición
                     (top:14px right:14px en lugar de bottom:7% right:5%). -->
                <div class="cad-annotation cad-annotation--mobile-keep cad-axis" data-anno="axis-xyz">
                    <svg class="cad-axis-svg" viewBox="0 0 50 50" width="56" height="56" focusable="false">
                        <line x1="15" y1="35" x2="42" y2="35"/>
                        <line x1="15" y1="35" x2="15" y2="8"/>
                        <line x1="15" y1="35" x2="4" y2="46"/>
                        <circle cx="15" cy="35" r="1.8"/>
                        <text x="45" y="38" font-size="8">X</text>
                        <text x="12" y="6" font-size="8">Y</text>
                        <text x="0" y="49" font-size="8">Z</text>
                    </svg>
                </div>

                <!-- Mobile-only: 3 tick marks decorativos sobre línea main
                     bottom (sin cota textual). Solo display en mobile via
                     CSS modifier mobile-only. Posición se acerca a la
                     curva _lines proyectada en mobile (~bottom:18% center). -->
                <div class="cad-annotation cad-annotation--mobile-only" data-anno="mobile-ticks">
                    <svg class="cad-mobile-ticks-svg" viewBox="0 0 100 8" width="180" height="8" focusable="false">
                        <line x1="2" y1="0" x2="2" y2="8"/>
                        <line x1="50" y1="0" x2="50" y2="8"/>
                        <line x1="98" y1="0" x2="98" y2="8"/>
                    </svg>
                </div>
            </div>
            <div class="container">
                <div class="s_avanzosc_hero_inner">
                    <h1 class="s_avanzosc_hero_claim"><t t-esc="hero_claim"/></h1>
                    <p class="s_avanzosc_hero_subtitle"><t t-esc="hero_subtitle"/></p>
                    <div class="s_avanzosc_hero_actions">
                        <a t-att-href="hero_cta_primary_url" class="btn btn-primary btn-lg s_avanzosc_hero_cta_primary"><t t-esc="hero_cta_primary_text"/></a>
                        <a t-att-href="hero_cta_secondary_url" class="s_avanzosc_hero_cta_secondary"><t t-esc="hero_cta_secondary_text"/></a>
                    </div>
                    <!-- TODO #spec-q8: evaluar foto/illustration aquí cuando se
                         cierre sesión fotográfica del equipo Avanzosc. v1 va
                         sin imagen per CLAUDE.md §9.6 (NO stock photos) y
                         decisión E sesión 2026-04-28. Punto de inserción
                         estable: dentro de .s_avanzosc_hero_inner, debajo de
                         .s_avanzosc_hero_actions o en col paralela. -->
                </div>
            </div>
        </section>
    </template>
</odoo>
